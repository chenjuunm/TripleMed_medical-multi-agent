# Optional remote OpenAI-compatible API. When MODEL_API_KEY is non-empty, both
# the main model and Router use this API; leave it empty to use LM Studio.
# Never commit a real key.
MODEL_API_KEY=
# Only applies when every evidence source explicitly has is_demo=true.
# false restores the standard Critic policy; restart after changing environment.
CRITIC_DEMO_MODE=true
MODEL_API_BASE_URL=https://api.openai.com/v1
API_AGENT_MODEL=gpt-5.4-mini
API_ROUTER_MODEL=gpt-5.4-mini
API_VERIFIER_MODEL=gpt-5.4-mini

# LM Studio local OpenAI-compatible server (used when MODEL_API_KEY is empty)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_TIMEOUT_SECONDS=300
LM_STUDIO_MAX_RETRIES=1
MODEL_PREFLIGHT_TIMEOUT_SECONDS=5

# Optional Hugging Face endpoint for the Chinese BGE embedding model.
# Omit this variable to use the official default.
HF_ENDPOINT=https://huggingface.co

# Stable identifiers assigned by scripts/start_lm_studio_models.sh
AGENT_MODEL=medical-main-qwen38-27b
ROUTER_MODEL=medical-router-qwen35-9b
VERIFIER_MODEL=medical-main-qwen38-27b
AGENT_REASONING_EFFORT=none
ROUTER_REASONING_EFFORT=none
VERIFIER_REASONING_EFFORT=none
AGENT_MAX_TOKENS=2048
ROUTER_MAX_TOKENS=1024
VERIFIER_MAX_TOKENS=1536

# Optional LM Studio model-key overrides. 27B defaults to the variant selected in
# My Models (Q6_K for the default profile); every 9B key is forced to @4bit by
# scripts/start_lm_studio_models.sh, even if an @8bit suffix is supplied here.
LM_STUDIO_MAIN_MODEL_KEY=qwen/qwen3.8-27b
LM_STUDIO_ROUTER_MODEL_KEY=qwen/qwen3.5-9b@4bit
LM_STUDIO_MAIN_CONTEXT_LENGTH=8192
LM_STUDIO_ROUTER_CONTEXT_LENGTH=4096
LM_STUDIO_MAIN_PARALLEL=2
LM_STUDIO_MAIN_TTL_SECONDS=3600
LM_STUDIO_ROUTER_TTL_SECONDS=3600

# Resource budgets for the agent graph
MAX_SPECIALIST_AGENTS=2
MAX_RECORD_REQUESTS=4
MAX_GUIDELINE_QUERIES=3
MAX_REFLECTION_ROUNDS=1

# HITL examination-order approval (required to approve or reject a proposal)
# Replace this value for every environment; do not commit a real secret.
CLINICIAN_APPROVAL_TOKEN=replace-with-a-random-local-secret
CLINICIAN_ALLOWED_ROLES=clinician,doctor,attending
EXAM_ORDER_APPROVAL_TTL_SECONDS=900

# Local opt-in QA knowledge base (SQLite)
ANSWER_KNOWLEDGE_DB=./answer_knowledge_db/answers.sqlite3
